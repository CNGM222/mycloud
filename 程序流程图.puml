@startuml
title MyCloud 程序流程图

start

partition 客户端 {
  :用户访问系统;
  :展示登录/注册页面;

  if (是否已有账号?) then (是)
    :输入账号密码;
    :发起登录请求;
  else (否)
    :填写注册信息;
    :发起注册请求;
  endif
}

partition 服务端 {
  if (请求类型是注册?) then (是)
    :校验注册信息;
    :创建用户账号;
    :返回注册结果;
  else (否)
    :校验账号密码;
    :生成会话与令牌;
    :返回认证结果;
  endif
}

partition 客户端 {
  if (认证是否通过?) then (通过)
    :进入系统首页;
  else (失败)
    :提示认证失败;
    stop
  endif
}

while (用户是否继续操作?) is (是)
  partition 客户端 {
    :选择功能;

    if (上传文件?) then (是)
      :选择本地文件;
      :提交上传请求;
    elseif (下载文件?) then (是)
      :选择目标文件;
      :提交下载请求;
    elseif (预览文件?) then (是)
      :选择目标文件;
      :提交预览请求;
    elseif (分享文件?) then (是)
      :选择目标文件;
      :设置分享范围/有效期;
      :提交分享请求;
    elseif (管理文件?) then (是)
      :选择新建目录/重命名/移动/删除;
      :提交管理请求;
    else (退出登录)
      :发起退出请求;
    endif
  }

  partition 服务端 {
    if (上传请求?) then (是)
      :校验文件类型与大小;
      if (校验通过?) then (通过)
        :写入文件元数据;
        :上传文件到云端存储;
        :更新用户空间信息;
        :记录上传日志;
        :返回上传结果;
      else (失败)
        :返回校验失败信息;
      endif
    elseif (下载请求?) then (是)
      :校验访问权限;
      if (有权限?) then (是)
        :定位文件存储地址;
        :生成下载流;
        :记录下载日志;
        :返回文件内容;
      else (否)
        :返回无权限信息;
      endif
    elseif (预览请求?) then (是)
      :校验访问权限;
      if (可预览?) then (是)
        :读取文件元数据;
        :生成预览内容;
        :返回预览结果;
      else (否)
        :返回不可预览信息;
      endif
    elseif (分享请求?) then (是)
      :校验文件权限;
      :生成分享链接或共享记录;
      :记录分享日志;
      :返回分享结果;
    elseif (管理请求?) then (是)
      :执行对应文件管理操作;
      :更新文件元数据;
      :记录操作日志;
      :返回处理结果;
    else (退出请求)
      :销毁会话或令牌;
      :返回退出结果;
    endif
  }

  partition 客户端 {
    if (本次请求成功?) then (是)
      :刷新页面或展示结果;
    else (否)
      :展示错误提示;
    endif

    if (是否退出登录?) then (是)
      break
    endif
  }
endwhile (否)

stop
@enduml
